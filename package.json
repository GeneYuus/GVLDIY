{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=1152 next dev -p 3000",
    "build": "rm -rf .next && tsc --noEmit && NODE_OPTIONS=--max-old-space-size=1152 next build",
    "start": "if [ -f .next/standalone/server.js ]; then [ -d .next/standalone/public ] || cp -r public .next/standalone/public; mkdir -p .next/standalone/.next; [ -d .next/standalone/.next/static ] || cp -r .next/static .next/standalone/.next/static; NODE_OPTIONS=--max-old-space-size=512 HOSTNAME=0.0.0.0 PORT=${PORT:-3000} node .next/standalone/server.js; else NODE_OPTIONS=--max-old-space-size=512 next start -p ${PORT:-3000}; fi",
    "lint": "NODE_OPTIONS=--max-old-space-size=512 eslint .",
    "clean": "next clean"
  },
  "dependencies": {
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.2.1",
    "@puckeditor/core": "^0.24.1",
    "@types/qrcode": "^1.5.6",
    "@vepando/liquid-glass-react": "^1.3.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
