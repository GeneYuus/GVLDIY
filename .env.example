# ==============================================================================
# GREENVILLE DIY ARCHIVE & BARTER MARKET — ZERO-EDIT ENVIRONMENT CONTRACT
#
# [A] DEMO / PREVIEW MODE (Development Default — Zero Config Needed):
#     In development (NODE_ENV !== 'production'), leave DB_HOST,
#     ADMIN_PASSWORD_HASH, and ADMIN_PASSKEY blank. The app binds to PORT=3000,
#     runs on the seeded in-memory store, and enables iframe-safe 1-click
#     "Instant Demo Unlock" on /admin.
#
# [B] HOSTINGER PRODUCTION CUTOVER (Fail-Closed Security Posture):
#     In production (NODE_ENV=production), Demo Unlock and TOFU passkey claiming
#     are unconditionally disabled. Set DB_HOST="127.0.0.1", DB_NAME, DB_USER,
#     DB_PASSWORD, ADMIN_PASSWORD_HASH (generated via /admin -> 07. Cutover),
#     and a 32+ character ADMIN_SESSION_SECRET in Hostinger hPanel.
# ==============================================================================

# Optional explicit port override (defaults to 3000 in preview; Hostinger sets PORT automatically)
PORT="3000"

# APP_URL: Canonical production domain once cut over (e.g. https://greenvillediyarchive.org)
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Reserved for server-side studio utilities if enabled later
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- STEP 1: HOSTINGER ADMIN AUTHENTICATION (Required in NODE_ENV=production) ---
# Generate ADMIN_PASSWORD_HASH (scrypt$65536$8$2$<saltHex>$<hashHex>) inside /admin -> 07. Cutover
ADMIN_PASSWORD_HASH=""
# Optional legacy plaintext fallback (derived once asynchronously at boot if ADMIN_PASSWORD_HASH is empty)
ADMIN_PASSKEY=""
# Required in production: >= 32 random characters (e.g. openssl rand -hex 32)
ADMIN_SESSION_SECRET=""

# --- STEP 2: HOSTINGER LOCAL MYSQL (Always use 127.0.0.1 instead of localhost for IPv4 TCP) ---
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# --- STEP 3: OFF-HOSTINGER MEDIA STREAMING (Optional HTTP 206 Range Proxy & $0 Egress CDN) ---
GDRIVE_CLIENT_EMAIL=""
GDRIVE_PRIVATE_KEY=""
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.greenvillediyarchive.org"

# --- STEP 4: INSTAGRAM GRAPH API WEBHOOK SECRETS (Barter Market "SOLD" Comment Verification) ---
IG_WEBHOOK_APP_SECRET=""
IG_VERIFY_TOKEN=""

# --- STEP 5: OPTIONAL GOOGLE SHEETS LIVE SUBSCRIBER MIRROR ---
GSHEETS_SUBSCRIBER_SPREADSHEET_ID=""
