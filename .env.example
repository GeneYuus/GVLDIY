# ==============================================================================
# GREENVILLE DIY ARCHIVE & BARTER MARKET — ZERO-EDIT ENVIRONMENT CONTRACT
#
# [A] DEMO / PREVIEW MODE (Current Default — Zero Config Needed):
#     Leave DB_HOST and ADMIN_PASSKEY blank. The app automatically binds to
#     PORT=3000, runs on the seeded in-memory store, and enables iframe-safe
#     1-click "Instant Demo Unlock" on /admin.
#
# [B] HOSTINGER PRODUCTION CUTOVER (Zero Code Edits Required):
#     In Hostinger hPanel -> Websites -> Node.js -> Environment Variables, set
#     DB_HOST="127.0.0.1", DB_NAME, DB_USER, DB_PASSWORD, ADMIN_PASSKEY, and
#     ADMIN_SESSION_SECRET. The app automatically binds Hostinger's $PORT,
#     creates all MySQL tables via CREATE TABLE IF NOT EXISTS, and disables
#     Demo Unlock in favor of your passkey.
# ==============================================================================

# Optional explicit port override (defaults to 3000 in preview; Hostinger sets PORT automatically)
PORT="3000"

# APP_URL: Canonical production domain once cut over (e.g. https://greenvillediyarchive.org)
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Reserved for server-side studio utilities if enabled later
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- STEP 1: HOSTINGER ADMIN AUTHENTICATION (Leave blank in preview for 1-click Demo Unlock) ---
ADMIN_PASSKEY=""
ADMIN_SESSION_SECRET=""

# --- STEP 2: HOSTINGER LOCAL MYSQL (Always use 127.0.0.1 instead of localhost for IPv4 TCP) ---
DB_HOST=""
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# --- STEP 3: OFF-HOSTINGER MEDIA STREAMING (Optional HTTP 206 Range Proxy & $0 Egress CDN) ---
GDRIVE_CLIENT_EMAIL=""
GDRIVE_PRIVATE_KEY=""
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.greenvillediyarchive.org"

# --- STEP 4: INSTAGRAM GRAPH API WEBHOOK SECRETS (Barter Market "SOLD" Comment Verification) ---
IG_WEBHOOK_APP_SECRET="replace-with-meta-app-secret"
IG_VERIFY_TOKEN="greenville-diy-barter-verify"

# --- STEP 5: OPTIONAL GOOGLE SHEETS LIVE SUBSCRIBER MIRROR ---
GSHEETS_SUBSCRIBER_SPREADSHEET_ID=""
